def render(maze, player, visited, message=""):
    clear()
    print(C.BOLD + "=" * 60 + C.RESET)
    print(C.BOLD + "  🏰  ЛАБИРИНТ  🏰" + C.RESET)
    print(C.BOLD + "=" * 60 + C.RESET)
    print(f"  {hearts(player.hp, player.max_hp, color=C.RED)}")
    print(f"  💰 Золото: {C.YELLOW}{player.gold}{C.RESET}   "
          f"🍞 Еда: {player.food}")
    inv_str = "  ".join(f"{it.icon}{it.name}" for it in player.inventory.items)
    print(f"  🎒 Инвентарь: {inv_str if inv_str else C.DIM + 'пусто' + C.RESET}")
    flags = []
    if player.has_key: flags.append("🔑")
    if player.has_ruby: flags.append("💎")
    if player.key_combined: flags.append("🔓")
    if player.princess_saved: flags.append("👸")
    print(f"  📜 Статус: {' '.join(flags) if flags else '—'}")

    if player.key_combined:
        goal = "🚪 Найти выход и открыть дверь!"
    elif player.has_ruby and player.has_key:
        goal = "🎒 Соединить 🔑 Ключ + 💎 Рубин в инвентаре (клавиша I)!"
    elif player.has_ruby:
        goal = "🔑 Найти Ключ в комнате с ключом!"
    elif player.princess_saved:
        goal = "🔑 Найти Ключ!"
    else:
        goal = "🐉 Победить дракона и спасти принцессу!"
    print(f"  🎯 Цель: {C.YELLOW}{goal}{C.RESET}")
    print("-" * 60)

    for r in range(maze.rows):
        row_str = ""
        for c in range(maze.cols):
            if (r, c) == (player.x, player.y):
                row_str += PLAYER_ICON + " "
            elif (r, c) in visited:
                sym, _ = SYMBOLS[maze.grid[r][c]]
                row_str += sym + " "
            else:
                row_str += UNKNOWN_ICON + " "
        print(row_str)
    print("-" * 60)
    if message:
        print(C.CYAN + message + C.RESET)
    print(C.DIM + "W/A/S/D — движение, I — инвентарь, Q — выход" + C.RESET)

