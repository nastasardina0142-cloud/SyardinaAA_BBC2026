# ЛОВУШКА — 3+ ОШИБКИ = СМЕРТЬ
# ============================================================
def trap_room(player):
    print(C.MAGENTA + "⚠️  ЛОВУШКА! Реши 5 примеров." + C.RESET)
    print(C.RED + "💀 Внимание: 3 ошибки — смерть!" + C.RESET)
    print(f"  Ваше здоровье: {hearts(player.hp, player.max_hp, color=C.GREEN)}")
    print()

    mistakes = 0

    for i in range(5):
        a, b = random.randint(1, 20), random.randint(1, 20)
        op = random.choice(["+", "-", "*"])
        ans = a + b if op == "+" else a - b if op == "-" else a * b

        print(f"  Ошибок: {mistakes}/2   ❤️  Осталось: {player.hp}/{player.max_hp}")
        try:
            user = int(input(f"  Пример {i+1}/5: {a} {op} {b} = "))
        except ValueError:
            user = None

        if user == ans:
            if random.random() < 0.5:
                player.gold += random.randint(5, 15)
                print(C.GREEN + "  ✅ Верно! 💰 +золото" + C.RESET)
            else:
                player.food += 1
                print(C.GREEN + "  ✅ Верно! 🍞 +еда" + C.RESET)
        else:
            mistakes += 1
            player.hp -= 1
            print(C.RED + f"  ❌ Неверно! Ответ: {ans}." + C.RESET)
            print(C.RED + f"  -1 ❤️  Теперь: {hearts(player.hp, player.max_hp, color=C.RED)}" + C.RESET)
            print(C.RED + f"  Ошибок: {mistakes}/2" + C.RESET)

            # ============================
            # 💀 СМЕРТЬ ОТ 3+ ОШИБОК
            # ============================
            if mistakes > 2:
                print()
                print(C.BOLD + C.RED + "💀💀💀 ТРИ ОШИБКИ! ЛОВУШКА УБИВАЕТ ВАС!" + C.RESET)
                time.sleep(1.5)
                game_over("Три ошибки в комнате с ⚠️ ловушкой")  # ← новый лабиринт

            # ============================
            # 💀 СМЕРТЬ ОТ HP = 0
            # ============================
            if player.hp <= 0:
                print(C.BOLD + C.RED + "💀 Здоровье закончилось..." + C.RESET)
                time.sleep(1.5)
                game_over("Здоровье закончилось в комнате с ⚠️ ловушкой")

    input("  Enter...")
    return True

