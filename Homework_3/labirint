class Dragon:
    def __init__(self):
        self.name = "🐉 Древний Дракон"
        self.hp = 8
        self.max_hp = 8
        self.attacks = [
            ("🔥 Огненное дыхание", 2),
            ("🦷 Укус",             1),
            ("🌀 Удар хвостом",     1),
            ("💨 Рёв ужаса",        1),
        ]

    def choose_attack(self): return random.choice(self.attacks)
    def is_alive(self): return self.hp > 0

