    print(C.BOLD + "🎒 ИНВЕНТАРЬ" + C.RESET)
    print(f"  {hearts(player.hp, player.max_hp, color=C.RED)}")
    print()
    if not player.inventory.items:
        print(C.DIM + "пусто" + C.RESET)
    else:
        for i, it in enumerate(player.inventory.items):
            print(f"  {i+1}. {it.icon} {it.name} (значимость={it.value}, тип={it.kind})")
    print()

    if player.has_key and player.has_ruby and not player.key_combined:
        print(C.BOLD + C.YELLOW + "💡 У вас есть 🔑 Ключ и 💎 Рубин!" + C.RESET)
        print(C.BOLD + C.YELLOW + "   Выберите пункт 4, чтобы соединить их." + C.RESET)
        print()

    print("  1) отсортировать по значимости (sort/reverse)")
    print("  2) выбросить предмет (pop/remove)")
    print("  3) улучшить меч кристаллом")
    print("  4) 🔓 соединить ключ с рубином")
    print("  5) shallow copy / slice / deepcopy демо")
    print("  6) список мечей (list comprehension)")
    print("  0) назад")
    choice = input("> ").strip()

    if choice == "1":
        player.inventory.sort_by_value(); print("Отсортировано!"); input("Enter...")
    elif choice == "2":
        if player.inventory.items:
            name = input("Имя предмета: ").strip()
            removed = player.inventory.remove_by_name(name)
            print(f"Выброшено: {removed}" if removed else "Не найдено")
        input("Enter...")
    elif choice == "3":
        if player.inventory.has("Кристалл") and player.inventory.has("Меч"):
            player.inventory.remove_by_name("Кристалл")
            for it in player.inventory.items:
                if it.kind == "sword":
                    it.bonus["damage"] = it.bonus.get("damage", 2) + 10
                    it.value += 50
                    it.name = "Меч +10 урона"
                    it.icon = "⚔️"
            print("Меч улучшен!")
        else:
            print("Нужен Кристалл и Меч")
        input("Enter...")
    elif choice == "4":
        if player.key_combined:
            print(C.DIM + "Уже соединено!" + C.RESET)
        elif player.has_key and player.has_ruby:
            print()
            print(C.BOLD + "🔑 + 💎 = ..." + C.RESET)
            time.sleep(0.6)
            print(C.YELLOW + "   ✨ Ключ начинает светиться... ✨" + C.RESET)
            time.sleep(0.6)
            print(C.MAGENTA + "   💫 Рубин вращается вокруг ключа... 💫" + C.RESET)
            time.sleep(0.6)
            print(C.GREEN + C.BOLD + "   🔓 КЛЮЧ С РУБИНОМ СОЗДАН!" + C.RESET)
            time.sleep(0.5)
            player.inventory.remove_by_name("Ключ")
            player.inventory.remove_by_name("Рубин")
            player.inventory.add(Item("Ключ с рубином", value=200, kind="key", icon="🔓"))
            player.key_combined = True
            print()
            print(C.CYAN + "🎯 Теперь найдите 🚪 выход, чтобы выбраться!" + C.RESET)
        else:
            print(C.RED + "❌ Нужны и 🔑 Ключ, и 💎 Рубин!" + C.RESET)
            if not player.has_key:
                print(C.DIM + "   У вас нет ключа." + C.RESET)
            if not player.has_ruby:
                print(C.DIM + "   У вас нет рубина." + C.RESET)
        input("Enter...")
    elif choice == "5":
        sc = player.inventory.shallow_copy()
        sl = player.inventory.slice_copy(0, min(2, len(player.inventory)))
        dc = player.inventory.deep_copy()
        print(f"shallow copy: {sc}")
        print(f"slice [0:2]:  {sl}")
        print(f"deepcopy:     {dc}")
        if sc: print(C.YELLOW + "⚠ shallow copy ссылается на те же объекты!" + C.RESET)
        input("Enter...")
    elif choice == "6":
        print(f"Мечи: {player.inventory.weapons()}"); input("Enter...")

