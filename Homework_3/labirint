def game_over(reason=""):
    """Показывает экран смерти. Игрок выбирает — заново или выйти."""
    clear()
    print()
    print(C.BOLD + C.RED + "╔" + "═" * 58 + "╗" + C.RESET)
    print(C.BOLD + C.RED + "║" + " " * 58 + "║" + C.RESET)
    print(C.BOLD + C.RED + "║" + C.BOLD + C.RED +
          "                    💀  ВЫ ПОГИБЛИ  💀                  ".center(58) +
          C.RESET + C.BOLD + C.RED + "║" + C.RESET)
    print(C.BOLD + C.RED + "║" + " " * 58 + "║" + C.RESET)
    print(C.BOLD + C.RED + "╚" + "═" * 58 + "╝" + C.RESET)
    print()
    if reason:
        print(C.YELLOW + f"  Причина: {reason}" + C.RESET)
    print()
    print(C.CYAN + "  Лабиринт будет сгенерирован заново." + C.RESET)
    print()
    print("  1) 🔄 Начать заново")
    print("  2) 🚪 Выйти из игры")
    choice = input("  > ").strip()

    if choice == "2":
        print(C.DIM + "Выход из игры." + C.RESET)
        sys.exit(0)
    # по умолчанию — заново
    return play()  # НОВЫЙ ЛАБИРИНТ

