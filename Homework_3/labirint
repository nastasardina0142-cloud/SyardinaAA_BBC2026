# ============================================================
# БОЙ С ДРАКОНОМ
# ============================================================
def fight_dragon(player):
    dragon = Dragon()
    log = ["⚔️  Дракон преграждает путь! Принцесса в заложниках!"]

    while dragon.is_alive() and player.hp > 0:
        show_battle_status(player, dragon, log)
        print()
        print("  Действия:")
        print("    1) ⚔️  Атаковать")
        print("    2) 🛡️  Защититься (урон вдвое)")
        print("    3) 🧪 Выпить зелье")
        print("    4) 🔮 Магия (нужен кристалл)")
        print("    5) 🏃 Попытаться сбежать")
        choice = input("  > ").strip()

        player.defending = False
        skip_dragon_turn = False

        if choice == "1":
            if random.random() < 0.1:
                log.append(C.YELLOW + "👤 Вы промахнулись!" + C.RESET)
            else:
                dmg = player.attack_power()
                crit = random.random() < 0.2
                if crit: dmg *= 2
                dragon.hp -= dmg
                crit_text = C.BOLD + C.YELLOW + " КРИТ!" + C.RESET if crit else ""
                log.append(C.GREEN + f"👤 Вы нанесли {dmg} урона!{crit_text}" + C.RESET)

        elif choice == "2":
            player.defending = True
            log.append(C.CYAN + "👤 Вы встали в защиту (урон вдвое)" + C.RESET)

        elif choice == "3":
            potions = player.inventory.potions()
            if potions:
                player.inventory.remove_by_name(potions[0].name)
                heal = 4
                player.hp = min(player.max_hp, player.hp + heal)
                log.append(C.GREEN + f"🧪 Вы выпили зелье! +{heal} ❤️" + C.RESET)
            else:
                log.append(C.DIM + "🧪 Зелий нет!" + C.RESET)
                skip_dragon_turn = True

        elif choice == "4":
            if player.inventory.has("Кристалл"):
                player.inventory.remove_by_name("Кристалл")
                dmg = random.randint(4, 6)
                dragon.hp -= dmg
                log.append(C.MAGENTA + f"🔮 Магия! {dmg} урона!" + C.RESET)
            else:
                log.append(C.DIM + "🔮 Нет кристалла!" + C.RESET)
                skip_dragon_turn = True

        elif choice == "5":
            if random.random() < 0.5:
                log.append(C.YELLOW + "🏃 Вы сбежали из боя!" + C.RESET)
                show_battle_status(player, dragon, log)
                input("  Enter...")
                return False
            else:
                log.append(C.RED + "🏃 Побег не удался!" + C.RESET)

        else:
            log.append(C.DIM + "Неизвестное действие" + C.RESET)
            skip_dragon_turn = True

        if dragon.hp <= 0:
            dragon.hp = 0
            break

        if skip_dragon_turn:
            continue

        time.sleep(0.4)
        atk_name, atk_dmg = dragon.choose_attack()
        if player.defending:
            atk_dmg = max(1, atk_dmg // 2)
            log.append(C.RED + f"{dragon.name}: {atk_name} на {atk_dmg} (защита)" + C.RESET)
        else:
            log.append(C.RED + f"{dragon.name}: {atk_name} на {atk_dmg}" + C.RESET)
        player.hp -= atk_dmg

    show_battle_status(player, dragon, log)

    # ============================
    # 💀 СМЕРТЬ В БОЮ
    # ============================
    if player.hp <= 0:
        print()
        print(C.BOLD + C.RED + "💀 Вы пали в бою с драконом..." + C.RESET)
        input("  Enter...")
        game_over("Вы пали в бою с 🐉 драконом")  # ← новый лабиринт

    print()
    print(C.BOLD + C.GREEN + "🎉 Дракон побеждён! 🎉" + C.RESET)
    time.sleep(0.8)
    print(C.YELLOW + "👸 Принцесса выходит из темницы..." + C.RESET)
    time.sleep(0.8)
    print(C.GREEN + "👸 «Спасибо, герой! Возьми этот 💎 Рубин.»" + C.RESET)
    time.sleep(0.6)
    print(C.GREEN + "👸 «Соедини его с 🔑 Ключом в инвентаре," + C.RESET)
    print(C.GREEN + "    чтобы открыть 🚪 дверь выхода.»" + C.RESET)
    player.princess_saved = True
    player.has_ruby = True
    player.inventory.add(Item("Рубин", value=150, kind="ruby", icon="💎"))
    player.inventory.add(Item("Зелье", value=40, kind="potion", icon="🧪"))
    print(C.CYAN + "🧪 Вы нашли зелье в сокровищнице дракона!" + C.RESET)
    print()
    print(C.BOLD + C.YELLOW + "📌 Задача: найти 🔑 Ключ, соединить с 💎 Рубином," + C.RESET)
    print(C.BOLD + C.YELLOW + "   затем найти 🚪 выход." + C.RESET)
    input("  Enter...")
    return True

# ============================================================
# ЛАБИРИНТ
# ============================================================
class Maze:
    def __init__(self, rows, cols):
        self.rows = rows
        self.cols = cols
        self.grid = [[EMPTY for _ in range(cols)] for _ in range(rows)]
        self.portal_map = {}
        self.generate()

    def free_cells(self):
        return [(r, c) for r in range(self.rows) for c in range(self.cols)
                if self.grid[r][c] == EMPTY]

    def place(self, room_type):
        cells = self.free_cells()
        if not cells: return None
        r, c = random.choice(cells)
        self.grid[r][c] = room_type
        return (r, c)

    def generate(self):
        self.monster_pos = self.place(MONSTER)
        self.key_pos = self.place(KEY)
        self.chest_pos = self.place(CHEST)
        self.trap_pos = self.place(TRAP)
        self.portal_positions = []
        for _ in range(3):
            p = self.place(PORTAL)
            if p: self.portal_positions.append(p)
        self.exit_pos = self.place(EXIT)
        if len(self.portal_positions) == 3:
            self.portal_map[self.portal_positions[0]] = "exit"
            self.portal_map[self.portal_positions[1]] = "monster"
            self.portal_map[self.portal_positions[2]] = "key"

