# ОСНОВНАЯ ИГРА
# ============================================================
def play():
    rows, cols = random.randint(5, 7), random.randint(5, 7)
    maze = Maze(rows, cols)
    start = random.choice(maze.free_cells() or [(0, 0)])
    player = Player(start[0], start[1])

    player.inventory.add(Item("Меч", value=50, kind="sword",
                              bonus={"damage": 2}, icon="⚔️"))
    player.inventory.add(Item("Кристалл", value=30, kind="crystal", icon="🔮"))
    player.inventory.add(Item("Зелье", value=40, kind="potion", icon="🧪"))

    visited = {start}
    message = "Вы очнулись в лабиринте..."

    while True:
        render(maze, player, visited, message)
        message = ""

        # ============================
        # 💀 СМЕРТЬ ОТ HP = 0 (общая проверка)
        # ============================
        if player.hp <= 0:
            game_over("Здоровье закончилось")  # ← новый лабиринт

        cmd = input("> ").strip().lower()
        if cmd == "q":
            print("Выход из игры."); return
        if cmd == "i":
            show_inventory(player); continue

        dx, dy = 0, 0
        if cmd == "w":   dx = -1
        elif cmd == "s": dx = 1
        elif cmd == "a": dy = -1
        elif cmd == "d": dy = 1
        else:
            message = "Неизвестная команда"; continue

        nx, ny = player.x + dx, player.y + dy
        if not (0 <= nx < maze.rows and 0 <= ny < maze.cols):
            message = "🚧 Стена! Туда нельзя."; continue

        player.x, player.y = nx, ny
        visited.add((nx, ny))
        room = maze.grid[nx][ny]

        if room == EMPTY:
            message = "Пустая комната."
        elif room == CHEST:
            if not player.inventory.has("Броня"):
                player.inventory.add(Item("Броня", value=80, kind="armor", icon="🛡️"))
                player.max_hp += 3
                player.hp += 3
                message = f"🎁 Сундук! Найдена 🛡️ Броня (+3 ❤️). Теперь: {hearts(player.hp, player.max_hp, color=C.GREEN)}"
            else:
                message = "Сундук пуст."
        elif room == MONSTER:
            if not player.princess_saved:
                alive = fight_dragon(player)
                if not alive: continue
            message = "Дракон побеждён. 👸 Принцесса спасена!"
        elif room == TRAP:
            if trap_room(player):
                message = "Ловушка пройдена."
        elif room == KEY:
            if not player.has_key:
                player.has_key = True
                player.inventory.add(Item("Ключ", value=120, kind="key", icon="🔑"))
                message = "🔑 Вы нашли Ключ!"
                if player.has_ruby:
                    message += " 💡 Соедините с рубином в инвентаре (I)!"
            else:
                message = "Ключ уже взят."
        elif room == PORTAL:
            target = maze.portal_map.get((nx, ny))

            if target == "exit":
                message = "🌀 Портал... телепорт к выходу!"
                player.x, player.y = maze.exit_pos
                visited.add((player.x, player.y))
                if player.key_combined:
                    victory_scene(player)
                    return

            elif target == "monster":
                if not player.princess_saved:
                    message = "🌀 Портал переносит вас прямо к 🐉 дракону!"
                    player.x, player.y = maze.monster_pos
                    visited.add((player.x, player.y))
                    render(maze, player, visited, message)
                    time.sleep(1.2)
                    alive = fight_dragon(player)
                    if not alive:
                        continue
                    message = "Дракон побеждён. 👸 Принцесса спасена!"
                else:
                    message = "💀 Дракон уже мёртв."

            elif target == "key":
                if player.has_ruby and not player.has_key:
                    message = "🌀 Портал к ключу!"
                    player.x, player.y = maze.key_pos
                    visited.add((player.x, player.y))
                else:
                    message = "Портал не сработал."

        elif room == EXIT:
            if player.key_combined:
                victory_scene(player)
                return
            else:
                if not player.princess_saved:
                    message = "🚪 Дверь заперта. Сначала спасите 👸 принцессу!"
                elif not player.has_ruby:
                    message = "🚪 Дверь заперта. Нужен 💎 Рубин от принцессы."
                elif not player.has_key:
                    message = "🚪 Дверь заперта. Нужен 🔑 Ключ."
                elif not player.key_combined:
                    message = "🚪 Дверь заперта. Соедините 🔑 + 💎 в инвентаре (I)!"


if __name__ == "__main__":
    try:
        play()
    except KeyboardInterrupt:
        print("\nИгра прервана.")