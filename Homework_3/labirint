# ============================================================
# ЦВЕТА
# ============================================================
class C:
    RESET = "\033[0m"
    RED = "\033[91m"
    GREEN = "\033[92m"
    YELLOW = "\033[93m"
    BLUE = "\033[94m"
    MAGENTA = "\033[95m"
    CYAN = "\033[96m"
    WHITE = "\033[97m"
    BOLD = "\033[1m"
    DIM = "\033[2m"

def clear():
    os.system("cls" if os.name == "nt" else "clear")

# ============================================================
# ТИПЫ КОМНАТ И ИКОНКИ
# ============================================================
EMPTY = "empty"
CHEST = "chest"
MONSTER = "monster"
TRAP = "trap"
KEY = "key"
PORTAL = "portal"
EXIT = "exit"

SYMBOLS = {
    EMPTY:   ("·",  "пустая"),
    CHEST:   ("🎁", "сундук"),
    MONSTER: ("🐉", "дракон"),
    TRAP:    ("⚠️", "ловушка"),
    KEY:     ("🔑", "ключ"),
    PORTAL:  ("🌀", "портал"),
    EXIT:    ("🚪", "выход"),
}

PLAYER_ICON = "👤"
UNKNOWN_ICON = "❓"
HEART_FULL = "❤️"
HEART_EMPTY = "🖤"

# ============================================================
# HP В ВИДЕ СЕРДЕЧЕК
# ============================================================
def hearts(current, maximum, color=C.RED):
    current = max(0, min(current, maximum))
    full = HEART_FULL * current
    empty = HEART_EMPTY * (maximum - current)
    return f"{full}{empty} {color}({current}/{maximum}){C.RESET}"

# ============================================================
# ПРЕДМЕТ
# ============================================================
class Item:
    def __init__(self, name, value=0, kind="misc", bonus=None, icon="📦"):
        self.name = name
        self.value = value
        self.kind = kind
        self.bonus = bonus or {}
        self.icon = icon

    def __repr__(self):
        return f"{self.icon} {self.name}"

# ============================================================
# ИНВЕНТАРЬ
# ============================================================
class Inventory:
    def __init__(self):
        self.items = []

    def add(self, item): self.items.append(item)
    def add_many(self, items): self.items.extend(items)
    def remove_by_name(self, name):
        for i, it in enumerate(self.items):
            if it.name == name:
                return self.items.pop(i)
        return None
    def pop_last(self): return self.items.pop() if self.items else None
    def sort_by_value(self, descending=True):
        self.items.sort(key=lambda it: it.value, reverse=descending)
    def has(self, name): return any(it.name == name for it in self.items)
    def find_index(self, name):
        names = [it.name for it in self.items]
        return names.index(name) if name in names else -1
    def shallow_copy(self): return self.items.copy()
    def slice_copy(self, s, e): return self.items[s:e]
    def deep_copy(self): return copy.deepcopy(self.items)
    def weapons(self): return [it for it in self.items if it.kind == "sword"]
    def potions(self): return [it for it in self.items if it.kind == "potion"]
    def total_value(self): return sum(it.value for it in self.items)
    def names(self): return [it.name for it in self.items]
    def __len__(self): return len(self.items)

# ============================================================
# ИГРОК
# ============================================================
class Player:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.hp = 10
        self.max_hp = 10
        self.inventory = Inventory()
        self.has_key = False
        self.has_ruby = False
        self.key_combined = False
        self.princess_saved = False
        self.gold = 0
        self.food = 0
        self.defending = False

    def attack_power(self):
        base = 2 if any(it.kind == "sword" for it in self.inventory.items) else 1
        for it in self.inventory.items:
            if it.kind == "sword":
                base += it.bonus.get("damage", 0) - 2
        return max(1, base)

