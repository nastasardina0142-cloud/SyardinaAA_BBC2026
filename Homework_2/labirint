elif (x == "Уровень 4"):
    print("Выберите операциюю:\n1)isdigit()\n2)isalpha()\n3)strip()\n4)format()\n5)r\n6)l\n7)f")
    text = input("Введите ваш текст\n")
    app = input("Ведите операцию\n")
    
    def a(text, app):
        if app == isdigit():
            return text.isdigit()
        elif app == isalpha():
            return text.isalpha()
        elif app == strip():
            return text.strip()
        elif app == format():
            return text.format()
        elif app == 'r':
            return text.word[::-1]
        elif app == 'l':
            return text.lower()
        elif app == 'f':
            return text.upper()
        else:
            return "Неверный метод"
    print (a(text, app))

elif (x == "Уровень 5"):
    print("Комплексное преобразование строки")
    text = input("Введите ваш текст\n")
    
    def a(text: str) -> str:
        text = text.strip().capitalize()
        text = text.replace(';', ' ')
        text = text.replace('-', ' ')
        text = text.replace('+', ' ')
        words = text.split()
        return ' '.join(words)
    print (a(words))