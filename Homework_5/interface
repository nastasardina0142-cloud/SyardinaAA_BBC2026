import sys
from PyQt6.QtWidgets import (
    QApplication,
    QMainWindow,
    QWidget,
    QVBoxLayout,
    QHBoxLayout,
    QFormLayout,
    QLabel,
    QLineEdit,
    QComboBox,
    QCheckBox,
    QPushButton,
    QMessageBox,
    QFrame,
    QInputDialog
)
from PyQt6.QtCore import Qt


class DormPaymentApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("DormPay — Оплата общежития")
        self.setMinimumSize(540, 620)

        self.balance = 3000

        self.tariffs = {
            "Бюджетная основа — 850 ₽ / мес.": 850,
            "Контрактная основа — 2 500 ₽ / мес.": 2500,
            "Повышенная комфортность — 4 200 ₽ / мес.": 4200
        }

        self.init_ui()
        self.apply_styles()

    def init_ui(self):
        central_widget = QWidget()
        self.setCentralWidget(central_widget)

        main_layout = QVBoxLayout(central_widget)
        main_layout.setSpacing(16)
        main_layout.setContentsMargins(24, 24, 24, 24)

        header_layout = QHBoxLayout()

        title_box = QVBoxLayout()
        title_label = QLabel("DormPay Dashboard")
        title_label.setObjectName("MainTitle")
        subtitle_label = QLabel("Система оплаты проживания и услуг")
        subtitle_label.setObjectName("SubTitle")
        title_box.addWidget(title_label)
        title_box.addWidget(subtitle_label)

        header_layout.addLayout(title_box)
        header_layout.addStretch()

        wallet_card = QFrame()
        wallet_card.setObjectName("WalletCard")
        wallet_layout = QHBoxLayout(wallet_card)
        wallet_layout.setContentsMargins(14, 10, 14, 10)
        wallet_layout.setSpacing(12)

        balance_info = QVBoxLayout()
        balance_caption = QLabel("Виртуальный счет")
        balance_caption.setObjectName("WalletCaption")
        self.balance_label = QLabel(f"{self.balance:,} ₽".replace(",", " "))
        self.balance_label.setObjectName("BalanceValue")
        balance_info.addWidget(balance_caption)
        balance_info.addWidget(self.balance_label)

        self.topup_button = QPushButton("+ Пополнить")
        self.topup_button.setObjectName("TopUpBtn")
        self.topup_button.setCursor(Qt.CursorShape.PointingHandCursor)

        wallet_layout.addLayout(balance_info)
        wallet_layout.addWidget(self.topup_button)
        header_layout.addWidget(wallet_card)

        main_layout.addLayout(header_layout)

        form_card = QFrame()
        form_card.setObjectName("Card")
        form_card_layout = QVBoxLayout(form_card)
        form_card_layout.setContentsMargins(20, 18, 20, 18)
        form_card_layout.setSpacing(12)

        section_title = QLabel("Параметры проживания")
        section_title.setObjectName("SectionTitle")
        form_card_layout.addWidget(section_title)

        form_layout = QFormLayout()
        form_layout.setSpacing(12)
        form_layout.setLabelAlignment(Qt.AlignmentFlag.AlignLeft)

        self.fio_input = QLineEdit()
        self.fio_input.setPlaceholderText("Введите ФИО студента")

        self.room_input = QLineEdit()
        self.room_input.setPlaceholderText("Номер комнаты (например: 412)")

        self.months_input = QLineEdit()
        self.months_input.setPlaceholderText("Срок в месяцах (от 1 до 12)")

        self.tariff_combo = QComboBox()
        self.tariff_combo.addItems(self.tariffs.keys())

        self.internet_check = QCheckBox("Высокоскоростной интернет (+300 ₽ / мес.)")
        self.laundry_check = QCheckBox("Безлимитная прачечная (+200 ₽ / мес.)")

        form_layout.addRow("Студент:", self.fio_input)
        form_layout.addRow("Комната:", self.room_input)
        form_layout.addRow("Тариф:", self.tariff_combo)
        form_layout.addRow("Период:", self.months_input)
        form_layout.addRow("Опции:", self.internet_check)
        form_layout.addRow("", self.laundry_check)

        form_card_layout.addLayout(form_layout)
        main_layout.addWidget(form_card)

        buttons_layout = QHBoxLayout()
        buttons_layout.setSpacing(12)

        self.calc_button = QPushButton("Рассчитать стоимость")
        self.calc_button.setObjectName("SecondaryBtn")
        self.calc_button.setCursor(Qt.CursorShape.PointingHandCursor)

        self.pay_button = QPushButton("Оплатить со счета")
        self.pay_button.setObjectName("PrimaryBtn")
        self.pay_button.setCursor(Qt.CursorShape.PointingHandCursor)

        buttons_layout.addWidget(self.calc_button)
        buttons_layout.addWidget(self.pay_button)
        main_layout.addLayout(buttons_layout)

        result_card = QFrame()
        result_card.setObjectName("ResultCard")
        result_layout = QVBoxLayout(result_card)
        result_layout.setContentsMargins(20, 16, 20, 16)

        res_header = QLabel("Детализация платежа")
        res_header.setObjectName("SectionTitle")
        result_layout.addWidget(res_header)

        self.result_label = QLabel("Заполните данные выше, чтобы рассчитать итоговую сумму к списанию.")
        self.result_label.setObjectName("ResultText")
        self.result_label.setWordWrap(True)
        result_layout.addWidget(self.result_label)

        main_layout.addWidget(result_card)

        self.topup_button.clicked.connect(self.top_up_balance)
        self.calc_button.clicked.connect(self.calculate_payment)
        self.pay_button.clicked.connect(self.process_payment)

