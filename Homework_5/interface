    def update_balance_display(self):
        self.balance_label.setText(f"{self.balance:,} ₽".replace(",", " "))

    def top_up_balance(self):
        amount, ok = QInputDialog.getInt(
            self,
            "Пополнение виртуального счета",
            "Введите сумму пополнения (от 100 до 50 000 ₽):",
            value=1000,
            min=100,
            max=50000,
            step=100
        )
        if ok:
            self.balance += amount
            self.update_balance_display()
            QMessageBox.information(
                self,
                    "Счет пополнен",
                    f"Баланс успешно пополнен на {amount} ₽.\nТекущий баланс: {self.balance} ₽."
            )

    def validate_and_get_data(self):
        fio = self.fio_input.text().strip()
        room = self.room_input.text().strip()
        months_text = self.months_input.text().strip()

        if not fio:
            self.show_error("Пожалуйста, укажите ФИО студента.")
            return None

        if not room.isdigit():
            self.show_error("Номер комнаты должен состоять только из цифр.")
            return None

        if not months_text.isdigit():
            self.show_error("Количество месяцев должно быть целым числом.")
            return None

        months = int(months_text)
        if months < 1 or months > 12:
            self.show_error("Укажите период оплаты от 1 до 12 месяцев.")
            return None

        tariff_name = self.tariff_combo.currentText()
        base_rate = self.tariffs[tariff_name]

        extras = 0
        if self.internet_check.isChecked():
            extras += 300
        if self.laundry_check.isChecked():
            extras += 200

        total_per_month = base_rate + extras
        total_sum = total_per_month * months

        return {
            "fio": fio,
            "room": room,
            "months": months,
            "total_per_month": total_per_month,
            "total_sum": total_sum
        }

    def calculate_payment(self):
        data = self.validate_and_get_data()
        if not data:
            return

        status = (
            "Достаточно средств на счете"
            if self.balance >= data["total_sum"]
            else f"Не хватает {data['total_sum'] - self.balance} ₽ — пополните счет"
        )

        self.result_label.setText(
            f"Плательщик: {data['fio']} (комната №{data['room']})\n"
            f"Ежемесячный платеж: {data['total_per_month']} ₽ × {data['months']} мес.\n"
            f"Итого к оплате: {data['total_sum']} ₽\n"
            f"Статус баланса: {status}"
        )

    def process_payment(self):
        data = self.validate_and_get_data()
        if not data:
            return

        self.calculate_payment()

        if self.balance < data["total_sum"]:
            missing = data["total_sum"] - self.balance
            reply = QMessageBox.warning(
                self,
                "Недостаточно средств",
                f"На виртуальном счете не хватает {missing} ₽.\n"
                f"Хотите пополнить счет сейчас?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
            )
            if reply == QMessageBox.StandardButton.Yes:
                self.top_up_balance()
            return

        reply = QMessageBox.question(
            self,
            "Подтверждение списания",
            f"Списать {data['total_sum']} ₽ с виртуального счета?\n"
            f"Студент: {data['fio']} (комн. №{data['room']})",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )

        if reply == QMessageBox.StandardButton.Yes:
            self.balance -= data["total_sum"]
            self.update_balance_display()
            self.result_label.setText(
                f"ОПЛАЧЕНО: {data['total_sum']} ₽\n"
                f"Студент: {data['fio']} (комната №{data['room']}), срок: {data['months']} мес.\n"
                f"Остаток на виртуальном счете: {self.balance} ₽"
            )
            QMessageBox.information(
                self,
                "Оплата выполнена",
                f"Платеж на сумму {data['total_sum']} ₽ успешно проведен!\n"
                f"Новый баланс: {self.balance} ₽."
            )

    def show_error(self, message):
        QMessageBox.warning(self, "Ошибка проверки данных", message)


if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = DormPaymentApp()
    window.show()
    sys.exit(app.exec())

